<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Scanlet's own manifest declares NO permissions:
      - The ML Kit document scanner runs inside Google Play services, which
        performs the capture itself, so no CAMERA permission is required.
      - ML Kit text recognition ships with the bundled model, so it is fully
        on-device.

      Google's transitive libraries (Firebase data transport telemetry pulled
      in by ML Kit) merge INTERNET and ACCESS_NETWORK_STATE into every app
      that uses them. Scanlet explicitly REMOVES both: the built APK cannot
      open network sockets, so no scan content — and no library telemetry —
      can ever leave the device. The only uses-permission in the merged
      manifest is the package-scoped DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION
      that AndroidX generates to guard app-internal receivers; it grants no
      access to anything.
    -->

    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".ScanletApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scanlet">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
